{
  "name": "@intellifin/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "probe": "pnpm --filter @intellifin/infrastructure probe",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=../../.env dist/main.js"
  },
  "dependencies": {
    "@intellifin/application": "workspace:*",
    "@intellifin/domain": "workspace:*",
    "@intellifin/infrastructure": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
