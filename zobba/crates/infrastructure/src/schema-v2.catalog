policy|clients|assigned_client|r|true|{0}|(EXISTS ( SELECT 1    FROM engagement_assignments a   WHERE ((a.organisation_id = clients.organisation_id) AND (a.client_id = clients.id))))|
policy|engagement_assignments|current_assignment|r|true|{0}|((actor_id = current_setting('zobba.actor_id'::text, true)) AND active AND ((expires_at IS NULL) OR (expires_at > (EXTRACT(epoch FROM statement_timestamp()))::bigint)) AND (EXISTS ( SELECT 1    FROM organisation_memberships m   WHERE ((m.organisation_id = engagement_assignments.organisation_id) AND (m.actor_id = engagement_assignments.actor_id)))) AND ((COALESCE(current_setting('zobba.client_id'::text, true), ''::text) = ''::text) OR (client_id = current_setting('zobba.client_id'::text, true))) AND ((COALESCE(current_setting('zobba.engagement_id'::text, true), ''::text) = ''::text) OR (engagement_id = current_setting('zobba.engagement_id'::text, true))))|
policy|engagements|assigned_engagement|r|true|{0}|(EXISTS ( SELECT 1    FROM engagement_assignments a   WHERE ((a.organisation_id = engagements.organisation_id) AND (a.client_id = engagements.client_id) AND (a.engagement_id = engagements.id))))|
policy|engagements|scoped_engagement_update|w|true|{0}|((organisation_id = current_setting('zobba.organisation_id'::text, true)) AND (client_id = current_setting('zobba.client_id'::text, true)) AND (id = current_setting('zobba.engagement_id'::text, true)) AND (EXISTS ( SELECT 1    FROM engagement_assignments a   WHERE ((a.organisation_id = engagements.organisation_id) AND (a.client_id = engagements.client_id) AND (a.engagement_id = engagements.id)))))|((organisation_id = current_setting('zobba.organisation_id'::text, true)) AND (client_id = current_setting('zobba.client_id'::text, true)) AND (id = current_setting('zobba.engagement_id'::text, true)) AND (EXISTS ( SELECT 1    FROM engagement_assignments a   WHERE ((a.organisation_id = engagements.organisation_id) AND (a.client_id = engagements.client_id) AND (a.engagement_id = engagements.id)))))
policy|organisation_memberships|current_membership|r|true|{0}|((actor_id = current_setting('zobba.actor_id'::text, true)) AND active AND ((expires_at IS NULL) OR (expires_at > (EXTRACT(epoch FROM statement_timestamp()))::bigint)) AND (roles && ARRAY['auditor'::text, 'audit_manager'::text]) AND (EXISTS ( SELECT 1    FROM identities i   WHERE ((i.id = organisation_memberships.actor_id) AND i.active))) AND ((COALESCE(current_setting('zobba.organisation_id'::text, true), ''::text) = ''::text) OR (organisation_id = current_setting('zobba.organisation_id'::text, true))))|
policy|organisations|assigned_organisation|r|true|{0}|(EXISTS ( SELECT 1    FROM engagement_assignments a   WHERE (a.organisation_id = organisations.id)))|
