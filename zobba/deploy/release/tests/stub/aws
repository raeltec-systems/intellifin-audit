#!/usr/bin/env python3
"""Offline stand-in for the `aws` CLI used by the release script tests.

It implements only the ECS calls the release scripts make, from a scenario
file (AWS_STUB_SCENARIO), keeps state in AWS_STUB_STATE and appends every call
to AWS_STUB_LOG. It never contacts AWS. Needs the `jmespath` package.
"""
import json
import os
import sys

import jmespath

args = sys.argv[1:]
with open(os.environ["AWS_STUB_LOG"], "a", encoding="utf-8") as log:
    log.write(" ".join(args) + "\n")

scenario = json.load(open(os.environ["AWS_STUB_SCENARIO"], encoding="utf-8"))
state_path = os.environ["AWS_STUB_STATE"]
state = json.load(open(state_path, encoding="utf-8")) if os.path.exists(state_path) else {
    "services": dict(scenario.get("services", {})), "registered": [], "polls": 0}


def option(name, default=None):
    return args[args.index(name) + 1] if name in args else default


def emit(value):
    query = option("--query")
    if query:
        value = jmespath.search(query, value)
    if option("--output") == "text":
        if value is None:
            print("None")
        elif isinstance(value, list):
            print("\t".join("None" if v is None else str(v) for v in value))
        else:
            print(value)
    else:
        print(json.dumps(value))


def save():
    json.dump(state, open(state_path, "w", encoding="utf-8"))


service, command = args[0], args[1]
assert service == "ecs", args
if command == "list-task-definitions":
    emit({"taskDefinitionArns": scenario["revisions"][option("--family-prefix")]})
elif command == "describe-task-definition":
    emit(scenario["definitions"][option("--task-definition")])
elif command == "register-task-definition":
    payload = json.load(open(option("--cli-input-json")[len("file://"):], encoding="utf-8"))
    arn = f"arn:aws:ecs:eu-west-1:123456789012:task-definition/{payload['family']}:{100 + len(state['registered'])}"
    state["registered"].append({"arn": arn, "payload": payload})
    save()
    emit({"taskDefinition": {"taskDefinitionArn": arn}})
elif command == "list-tasks":
    emit({"taskArns": scenario.get("running_migrations", [])})
elif command == "run-task":
    emit({"tasks": [{"taskArn": "arn:aws:ecs:eu-west-1:123456789012:task/cluster/migration1"}]})
elif command == "describe-tasks":
    if option("--query") == "tasks[0].lastStatus":
        state["polls"] += 1
        save()
    migration = scenario.get("migration", {})
    stopped = migration.get("stops_after_polls", 1) <= state["polls"]
    tasks = [{
        "taskArn": arn,
        "startedBy": scenario.get("running_started_by", "release-1"),
        "lastStatus": "STOPPED" if stopped else "RUNNING",
        "stoppedReason": migration.get("reason", "Essential container in task exited"),
        "containers": [{"name": "migrate", **({"exitCode": migration["exit_code"]} if "exit_code" in migration else {})}],
    } for arn in args[args.index("--tasks") + 1:] if arn.startswith("arn:")]
    emit({"tasks": tasks})
elif command == "stop-task":
    emit({"task": {}})
elif command == "update-service":
    name = option("--service")
    state["services"][name] = option("--task-definition")
    save()
    emit({"service": {"serviceArn": f"arn:aws:ecs:eu-west-1:123456789012:service/cluster/{name}"}})
elif command == "describe-services":
    name = option("--services")
    td = state["services"][name]
    revision = int(td.rsplit(":", 1)[-1])
    rollout = scenario.get("rollouts", {}).get(name, "COMPLETED") if revision >= 100 else "COMPLETED"
    emit({"services": [{
        "serviceName": name, "taskDefinition": td, "desiredCount": 2,
        "deployments": [{"status": "PRIMARY", "taskDefinition": td, "rolloutState": rollout,
                         "runningCount": 2, "desiredCount": 2}],
    }]})
else:
    sys.exit(f"stub aws: unsupported command {args}")
