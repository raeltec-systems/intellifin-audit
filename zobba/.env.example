# Copy to .env and supply credentials for your dedicated local PostgreSQL 18.
# These placeholders are not credentials. Never use the historical DATABASE_URL.
ZOBBA_MIGRATION_DATABASE_URL='postgresql://zobba_migrator:replace-local-password@127.0.0.1:5432/zobba_dev'
ZOBBA_RUNTIME_DATABASE_URL='postgresql://zobba_app:replace-local-password@127.0.0.1:5432/zobba_dev'

# Destructive integration/smoke checks reset this database. Its name must end in
# _test, and it must differ from the development database. Do not use real data.
ZOBBA_TEST_MIGRATION_DATABASE_URL='postgresql://zobba_migrator:replace-local-password@127.0.0.1:5432/zobba_local_test'
ZOBBA_TEST_RUNTIME_DATABASE_URL='postgresql://zobba_app:replace-local-password@127.0.0.1:5432/zobba_local_test'
# Elevated synthetic-role/interruption fixtures only, on the SAME disposable DB.
# Never supply this binding to API or worker processes.
ZOBBA_TEST_ADMIN_DATABASE_URL='postgresql://postgres:replace-local-admin-password@127.0.0.1:5432/zobba_local_test'

# Optional process bind addresses; defaults are loopback only.
ZOBBA_API_BIND='127.0.0.1:4310'
ZOBBA_WORKER_BIND='127.0.0.1:4311'
# Keep the web development proxy aligned if the API bind is changed.
ZOBBA_API_PROXY_TARGET='http://127.0.0.1:4310'
