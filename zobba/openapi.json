          "stop",
          "continue"
        ]
      },
      "CommandReceiptResponse": {
        "type": "object",
        "required": [
          "command_id",
          "task_id",
          "cycle_id",
          "event_cursor",
          "status"
        ],
        "properties": {
          "command_id": {
            "type": "string"
          },
          "cycle_id": {
            "type": "string"
          },
          "event_cursor": {
            "type": "string",
            "description": "Decimal commit-ordered cursor; represented as text to preserve integer precision.",
            "pattern": "^[0-9]+$"
          },
          "status": {
            "$ref": "#/components/schemas/ReceiptStatusResponse",
            "description": "Admission is durable. Applied and observed cessation are separate event/snapshot facts."
          },
          "task_id": {
            "type": "string"
          }
        }
      },
      "EngagementResponse": {
        "type": "object",
        "required": [
          "organisation_id",
          "organisation_name",
          "client_id",
          "client_name",
          "engagement_id",
          "engagement_name",
          "roles"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "client_name": {
            "type": "string",
            "description": "1–200 Unicode scalars; no C0/C1 controls or leading/trailing Unicode White_Space.",
            "maxLength": 200,
            "minLength": 1
          },
          "engagement_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "engagement_name": {
            "type": "string",
            "description": "1–200 Unicode scalars; no C0/C1 controls or leading/trailing Unicode White_Space.",
            "maxLength": 200,
            "minLength": 1
          },
          "organisation_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "organisation_name": {
            "type": "string",
            "description": "1–200 Unicode scalars; no C0/C1 controls or leading/trailing Unicode White_Space.",
            "maxLength": 200,
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EngagementsResponse": {
        "type": "object",
        "required": [
          "engagements",
          "next_cursor"
        ],
        "properties": {
          "engagements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EngagementResponse"
            },
            "maxItems": 50
          },
          "next_cursor": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ScopeResponse",
                "description": "Continue after this complete scope tuple; null means no further current assignments."
              }
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "service",
          "status",
          "schema_version"
        ],
        "properties": {
          "schema_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "service": {
            "$ref": "#/components/schemas/Service"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        }
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "live",
          "ready",
          "unavailable"
        ]
      },
      "IdentityResponse": {
        "type": "object",
        "required": [
          "id",
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "ReceiptStatusResponse": {
        "type": "string",
        "enum": [
          "received"
        ]
      },
      "ScopeResponse": {
        "type": "object",
        "required": [
          "organisation_id",
          "client_id",
          "engagement_id"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "engagement_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "organisation_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      },
      "Service": {
        "type": "string",
        "enum": [
          "api",
          "worker"
        ]
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "identity",
          "csrf_token"
        ],
        "properties": {
          "csrf_token": {
            "type": "string"
          },
          "identity": {
            "$ref": "#/components/schemas/IdentityResponse"
          }
        }
      },
      "TaskCommandRequest": {
        "type": "object",
        "required": [
          "key",
          "kind"
        ],
        "properties": {
          "content": {
            "type": [
              "string",
              "null"
            ],
            "description": "Exact retained text, at most 4000 UTF-8 bytes. Required only for Create and Guide.\nMust contain non-whitespace; control characters other than LF, CR and tab are refused.",
            "maxLength": 4000,
            "minLength": 1
          },
          "cycle_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "key": {
            "type": "string",
            "description": "Author and composite scope bind this key. Identical retries return the original receipt.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "kind": {
            "$ref": "#/components/schemas/CommandKindRequest"
          },
          "task_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required together with cycle_id except for Create, which requires both absent/null.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "additionalProperties": false
      },
      "TaskEventResponse": {
        "type": "object",
        "required": [
          "cursor",
          "task_id",
          "cycle_id",
          "command_id",
          "kind"
        ],
        "properties": {
          "command_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "cursor": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "cycle_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "Fixed event category, including received and applied. No content or capability is included."
          },
          "task_id": {
            "type": "string"
          }
        }
      },
      "TaskEventsResponse": {
        "type": "object",
        "required": [
          "events",
          "next_cursor"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskEventResponse"
            },
            "maxItems": 100
          },
          "next_cursor": {
            "type": "string",
            "description": "Last returned cursor, or the input cursor on an empty page. Poll again from this value.",
            "pattern": "^[0-9]+$"
          }
        }
      },
      "TaskResponse": {
        "type": "object",
        "required": [
          "id",
          "cycle_id",
          "objective",
          "working_brief",
          "state",
          "cessation",
          "intent_revision",
          "revision",
          "execution_epoch",
          "accountable_actor"
        ],
        "properties": {
          "accountable_actor": {
            "type": "string",
            "description": "Accountable human identity, distinct from worker ownership."
          },
          "cessation": {
            "$ref": "#/components/schemas/CessationResponse"
          },
          "cycle_id": {
            "type": "string"
          },
          "execution_epoch": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "id": {
            "type": "string"
          },
          "intent_revision": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "objective": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "state": {
            "$ref": "#/components/schemas/TaskStateResponse",
            "description": "Desired control/work state; Paused/Stopped require separate observed cessation."
          },
          "working_brief": {
            "type": "string",
            "description": "Retained plain text; no model understanding or audit result is asserted."
          }
        }
      },
      "TaskStateResponse": {
        "type": "string",
        "enum": [
          "ready",
          "running",
          "paused",
          "stopped",
          "waiting"
        ]
      },
      "TasksResponse": {
        "type": "object",
        "required": [
          "tasks",
          "next_cursor"
        ],
        "properties": {
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass this Task ID as after_task_id; null means no further current Tasks.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskResponse"
            },
            "description": "Current projection ordered by Task ID; open known IDs independently of this page.",
            "maxItems": 100
          }
        }
      }
    },
    "securitySchemes": {
      "login_binding": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-zobba-login",
        "description": "One-use current login browser binding; Secure, HttpOnly, SameSite=Lax, Path=/"
      },
      "server_session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-zobba-session",
        "description": "Opaque server session; Secure, HttpOnly, SameSite=Lax, Path=/; browser managed, never an OIDC provider token"
      }
    }
  }
}
