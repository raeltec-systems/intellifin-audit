{
  "openapi": "3.1.0",
  "info": {
    "title": "Zobba owned HTTP interface",
    "description": "Bootstrap service health only. No audit, identity or Task capability is implied.",
    "license": {
      "name": ""
    },
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [],
        "operationId": "live",
        "responses": {
          "200": {
            "description": "Process is serving; does not assert database readiness",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [],
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Runtime role and exact schema verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database or schema unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "service",
          "status",
          "schema_version"
        ],
        "properties": {
          "schema_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "service": {
            "$ref": "#/components/schemas/Service"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        }
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "live",
          "ready",
          "unavailable"
        ]
      },
      "Service": {
        "type": "string",
        "enum": [
          "api",
          "worker"
        ]
      }
    }
  }
}
