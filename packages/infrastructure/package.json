{
  "name": "@intellifin/infrastructure",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./src/db/index.ts",
      "default": "./dist/db/index.js"
    },
    "./migrate": {
      "types": "./src/db/migrate.ts",
      "default": "./dist/db/migrate.js"
    },
    "./probe": {
      "types": "./src/registrations/probe.ts",
      "default": "./dist/registrations/probe.js"
    },
    "./probe-runner": {
      "types": "./src/registrations/probe-runner.ts",
      "default": "./dist/registrations/probe-runner.js"
    },
    "./acquisition": {
      "types": "./src/runs/population-acquisition-http.ts",
      "default": "./dist/runs/population-acquisition-http.js"
    },
    "./evidence": {
      "types": "./src/evidence/s3-evidence-store.ts",
      "default": "./dist/evidence/s3-evidence-store.js"
    },
    "./extraction": {
      "types": "./src/runs/adapter-extraction-http.ts",
      "default": "./dist/runs/adapter-extraction-http.js"
    },
    "./credentials": {
      "types": "./src/runs/credential-resolver.ts",
      "default": "./dist/runs/credential-resolver.js"
    }
  },
  "files": [
    "dist",
    "src",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm --filter @intellifin/infrastructure... build && node dist/db/migrate.js",
    "probe": "pnpm build && node dist/registrations/probe-runner.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.47",
    "@ai-sdk/openai": "4.0.58",
    "@aws-sdk/client-s3": "3.1124.0",
    "@intellifin/application": "workspace:*",
    "@intellifin/domain": "workspace:*",
    "@sentry/node": "10.73.0",
    "ai": "7.0.89",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "pg-boss": "12.29.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
