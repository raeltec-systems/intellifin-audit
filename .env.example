# Copy to .env for local development. Never commit a real .env (AD-11: secrets and
# configuration enter only a composition root, through the validated schema).

# PostgreSQL 18 only — every process verifies server_version at bootstrap.
DATABASE_URL=postgres://postgres:pg@localhost:5432/postgres

# Which process this is: web | worker
SERVICE_NAME=web

# The schema generations this build supports (AD-15) are NOT configurable: they are
# a property of the build, in packages/infrastructure/src/db/compat.ts. A database
# outside that range makes the process refuse to start; it never migrates itself.

# Identity (web only; the worker has no identity surface and ignores both).
# BETTER_AUTH_SECRET signs the session cookie. At least 32 characters, generated
# per environment, never committed:  openssl rand -base64 48
# BETTER_AUTH_URL is the public origin a browser reaches, with the scheme. It must be
# https when NODE_ENV is production -- Better Auth marks the session cookie Secure only
# for an https origin, and a production build refuses to start with a plain-http one.
# http://localhost is for `pnpm dev` only, which runs with NODE_ENV=development.
# The web process refuses to start without them. Better Auth establishes identity and
# session only; the role comes from the user_role table and never from a token claim.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Operational telemetry accepts documented scalar fields only. Sentry is optional;
# leave SENTRY_DSN empty to disable it. PII and AI input/output capture stay off.
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# ---------------------------------------------------------------------------
# How this file is loaded
# ---------------------------------------------------------------------------
# Nothing loads it automatically. Each entry point reads it explicitly:
#
#   pnpm dev          web  -- Next.js reads .env from apps/web; for repo-root
#                             values, export them or copy this file there.
#   pnpm dev:worker   worker -- runs with `node --env-file-if-exists=../../.env`
#   pnpm db:migrate   requires DATABASE_URL in the environment; drizzle.config.ts
#                     throws rather than defaulting to an empty credential
#   pnpm test:integration  requires DATABASE_URL; skips locally without it, and
#                     fails fast when CI is set (see tests/integration/vitest.config.ts)
#   pnpm seed:identity  needs `pnpm build` first -- it runs under plain node and
#                     resolves the workspace packages to their built dist, not their
#                     source. Requires DATABASE_URL, BETTER_AUTH_SECRET,
#                     BETTER_AUTH_URL and SEED_PASSWORD. Operator-run only; it is the
#                     only way to create a user until Story 1.5 builds user
#                     administration. SEED_PASSWORD is read from the environment,
#                     never from an argument.
#
# One-off:  env $(grep -v '^#' .env | xargs) pnpm db:migrate

# Optional plan model. Leave provider/id/key empty for deterministic derivation.
# Provider: anthropic | openai. Model identity and prompt version freeze per version.
# The only prompt version supported by this build is 1. API key is worker-only.
# Set an output budget supported by the selected provider/model (1024..262144
# is the config envelope, not a claim that every model supports that maximum).
# Before HTTP, the full durable plan must fit UTF-8 byte length + 1024 reserve.
# Large authored inputs require a larger budget or shorter text.
MODEL_PROVIDER=
MODEL_ID=
MODEL_PROMPT_VERSION=1
MODEL_MAX_OUTPUT_TOKENS=16000
MODEL_API_KEY=

# --------------------------------------------------------------------- Epic 3
# Private object storage for Evidence. WORKER ONLY. Without every one of the
# five required values the worker DISABLES population execution by name and
# logs the reason once -- it does not crash, so plan derivation, notification
# delivery and the heartbeat keep running on a deployment whose bucket is not
# provisioned yet. FORCE_PATH_STYLE supports compatible stores (MinIO, R2).
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_REGION=
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
EVIDENCE_S3_FORCE_PATH_STYLE=

# The read-only capability manifest. JSON mapping an opaque credential
# reference to "read-only" or "write-capable". It is a DECLARATION, not a
# probe: reading the capability out of the reference's spelling would make
# the guarantee a naming convention anybody can satisfy by typing.
# An ABSENT value is an EMPTY manifest, which refuses every registration
# rather than accepting every one. Two keys that trim to one reference
# refuse the WHOLE manifest and the process does not start -- a deployment
# whose declaration is ambiguous has declared nothing.
#   {"loancore-audit":"read-only","accessgate-audit":"read-only"}
CREDENTIAL_CAPABILITIES=

# The tokens themselves, keyed by the same references. WORKER ONLY: in
# production a non-empty value on any other process refuses to start.
# Outside production it is allowed, because one environment file is routinely
# shared and the web has no code path that reads it.
CREDENTIAL_TOKENS=

# Exception fingerprint HMAC key. WORKER ONLY. Without it adapter execution
# is DISABLED by name rather than refusing to boot -- an Exception with no
# fingerprint is a permanent row nobody can later check. The key id is
# recorded on each Exception so a rotation stays traceable.
EXCEPTION_FINGERPRINT_KEY=
EXCEPTION_FINGERPRINT_KEY_ID=

# --------------------------------------------------------------------- Epic 4
# Managed remote browser for the Agent Workspace (getsolari.com). WORKER ONLY.
# Key format slr_live_... from console.getsolari.com. Absent, the workspace
# falls back to LOCAL Chromium, which isolates browser state per Run and does
# NOT isolate the worker process -- a Run that ran under the weaker guarantee
# records which mode it used and never inherits the stronger sentence.
# region defaults to us-west; SOLARI_BASE_URL replaces it for a staging or
# self-hosted gateway and is not set in a normal deployment.
SOLARI_API_KEY=
SOLARI_REGION=
SOLARI_BASE_URL=
