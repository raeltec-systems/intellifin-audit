# Copy to .env for local development. Never commit a real .env (AD-11: secrets and
# configuration enter only a composition root, through the validated schema).

# PostgreSQL 18 only — every process verifies server_version at bootstrap.
DATABASE_URL=postgres://postgres:pg@localhost:5432/postgres

# Which process this is: web | worker
SERVICE_NAME=web

# The schema generations this build supports (AD-15) are NOT configurable: they are
# a property of the build, in packages/infrastructure/src/db/compat.ts. A database
# outside that range makes the process refuse to start; it never migrates itself.

# Identity (web only; the worker has no identity surface and ignores both).
# BETTER_AUTH_SECRET signs the session cookie. At least 32 characters, generated
# per environment, never committed:  openssl rand -base64 48
# BETTER_AUTH_URL is the public origin a browser reaches, with the scheme.
# The web process refuses to start without them. Better Auth establishes identity and
# session only; the role comes from the user_role table and never from a token claim.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Operational telemetry accepts documented scalar fields only. Sentry is optional;
# leave SENTRY_DSN empty to disable it. PII and AI input/output capture stay off.
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# ---------------------------------------------------------------------------
# How this file is loaded
# ---------------------------------------------------------------------------
# Nothing loads it automatically. Each entry point reads it explicitly:
#
#   pnpm dev          web  -- Next.js reads .env from apps/web; for repo-root
#                             values, export them or copy this file there.
#   pnpm dev:worker   worker -- runs with `node --env-file-if-exists=../../.env`
#   pnpm db:migrate   requires DATABASE_URL in the environment; drizzle.config.ts
#                     throws rather than defaulting to an empty credential
#   pnpm test:integration  requires DATABASE_URL; skips locally without it, and
#                     fails fast when CI is set (see tests/integration/vitest.config.ts)
#   pnpm seed:identity  requires DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL and
#                     SEED_PASSWORD. Operator-run only; it is the only way to create a
#                     user until Story 1.5 builds user administration. SEED_PASSWORD is
#                     read from the environment, never from an argument.
#
# One-off:  env $(grep -v '^#' .env | xargs) pnpm db:migrate
